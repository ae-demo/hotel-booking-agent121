{
  "name": "hotel-booking-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "hotel-booking-api",
  "entrypoint": "deployment/service",
  "exposure": "intranet",
  "stories": [
    2,
    3,
    4,
    5,
    6,
    7
  ],
  "description": "Owns the hotel/room catalog and the traveler's bookings. Exposes search over hotels and rooms, and create/list/cancel for the caller's own bookings, charging and refunding through the internal payments API. Does not manage hotel inventory (no admin surface) and holds no conversation state — that belongs to hotel-booking-agent.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "hotel-booking-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "hotel-booking-age-f9cbd77b",
        "envBindings": {
          "dbname": "HOTEL_BOOKING_DB_DBNAME",
          "host": "HOTEL_BOOKING_DB_HOST",
          "password": "HOTEL_BOOKING_DB_PASSWORD",
          "port": "HOTEL_BOOKING_DB_PORT",
          "user": "HOTEL_BOOKING_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "hotel-booking-age-c1b490fe",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    },
    {
      "kind": "external",
      "name": "internal-payments-api",
      "description": "Charges the traveler at booking time and refunds them on cancellation.",
      "wiring": {
        "ref": "hotel-booking-age-57947bb0",
        "envBindings": {
          "PAYMENT_API_BASE_URL": "PAYMENT_API_BASE_URL"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
