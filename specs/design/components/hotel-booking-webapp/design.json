{
  "name": "hotel-booking-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "hotel-booking-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    1,
    2,
    3,
    4,
    5,
    6,
    7
  ],
  "description": "The traveler's browser front end: a single sign-in-gated chat surface that lets a traveler talk to hotel-booking-agent to search, book, pay for, view and cancel their own hotel stays. Holds no business data and calls no service directly other than the agent — the agent is the entire application logic.",
  "dependencies": [
    {
      "kind": "component",
      "name": "hotel-booking-agent",
      "description": "Sends the traveler's chat messages to the booking agent and renders its replies.",
      "wiring": {
        "endpoint": {
          "component": "hotel-booking-agent121-hotel-booking-agent",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "HOTEL_BOOKING_AGENT_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "hotel-booking-age-c1b490fe",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
